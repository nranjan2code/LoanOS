{
  "name": "loanos-india",
  "version": "0.2.0-alpha.1",
  "private": true,
  "type": "module",
  "description": "India-only LoanOS foundation covering LOS, LMS, LWS, and compliance-first AI governance.",
  "workspaces": [
    "packages/core"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "trace:sync": "node scripts/sync-capability-trace.mjs",
    "trace:validate": "node scripts/validate-capability-evidence.mjs",
    "docs:check": "node scripts/validate-documentation.mjs",
    "graph:check": "node scripts/validate-knowledge-graph.mjs",
    "currency:check": "node scripts/check-currency.mjs",
    "corpus:check": "node rules/tools/gen-eligibility-corpus.mjs && git diff --exit-code rules/fixtures/eligibility-corpus.json",
    "depth:check": "node scripts/audit-product-journey-depth.mjs",
    "knowledge:check": "npm run docs:check && npm run trace:validate && npm run graph:check && npm run depth:check && npm run currency:check",
    "dashboard": "node scripts/sync-capability-trace.mjs && node scripts/validate-capability-evidence.mjs && node scripts/build-dashboard.mjs && node scripts/validate-dashboard.mjs",
    "dashboard:check": "node scripts/validate-dashboard.mjs",
    "dashboard:watch": "node scripts/watch-dashboard.mjs",
    "web:check": "node apps/web/scripts/validate-public-site.mjs",
    "web:content:check": "node docs/gtm/automation/gtm-backlog-sync.mjs && node apps/web/scripts/validate-public-site.mjs",
    "academy:build": "node scripts/build-academy.mjs",
    "academy:check": "node scripts/build-academy.mjs --check",
    "technical-academy:build": "node scripts/build-technical-academy.mjs",
    "technical-academy:check": "node scripts/build-technical-academy.mjs --check",
    "demo:audit": "node scripts/demo-system.mjs audit",
    "demo:showcase": "node scripts/demo-system.mjs showcase",
    "demo:workshop": "node scripts/demo-system.mjs workshop",
    "demo:create-workshop": "node scripts/demo-system.mjs create-workshop",
    "gtm:proof": "node docs/gtm/automation/build-proof-sheet.mjs",
    "gtm:outreach": "node docs/gtm/automation/outreach-list-build.mjs",
    "gtm:health": "node docs/gtm/automation/cs-health-score.mjs",
    "probe": "node scripts/run-resilience-probe.mjs",
    "worker:identity": "node scripts/run-identity-operations-worker.mjs",
    "dev:api": "node apps/api/src/server.js",
    "start": "node apps/api/src/server.js",
    "prepare": "git config core.hooksPath tools/git-hooks"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "pg": "^8.22.0"
  }
}
