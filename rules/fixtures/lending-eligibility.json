{
  "key": "lending.eligibility",
  "bindings": [
    { "name": "requested_amount", "path": "/product/requested_amount", "type": "decimal", "required": false },
    { "name": "min_amount", "path": "/product/min_amount", "type": "decimal", "required": false },
    { "name": "max_amount", "path": "/product/max_amount", "type": "decimal", "required": false },
    { "name": "requested_tenor_months", "path": "/product/requested_tenor_months", "type": "int", "required": false },
    { "name": "default_tenor_months", "path": "/product/default_tenor_months", "type": "int", "required": false },
    { "name": "min_tenor_months", "path": "/product/min_tenor_months", "type": "int", "required": false },
    { "name": "max_tenor_months", "path": "/product/max_tenor_months", "type": "int", "required": false },
    { "name": "annual_interest_rate_bps", "path": "/product/annual_interest_rate_bps", "type": "int", "required": false },
    { "name": "apr_bps", "path": "/product/apr_bps", "type": "int", "required": false },
    { "name": "min_age_years", "path": "/product/eligibility/min_age_years", "type": "int", "required": false },
    { "name": "max_age_years", "path": "/product/eligibility/max_age_years", "type": "int", "required": false },
    { "name": "min_monthly_income", "path": "/product/eligibility/min_monthly_income", "type": "decimal", "required": false },
    { "name": "max_foir_policy", "path": "/product/eligibility/max_foir", "type": "decimal", "required": false },
    { "name": "date_of_birth", "path": "/borrower/date_of_birth", "type": "date", "required": false },
    { "name": "age_input", "path": "/borrower/age_years", "type": "int", "required": false },
    { "name": "monthly_income", "path": "/economic_profile/monthly_income", "type": "decimal", "required": false },
    { "name": "existing_obligations", "path": "/economic_profile/existing_monthly_obligations", "type": "decimal", "required": false },
    { "name": "bureau_present", "path": "/bureau_report", "type": "present", "required": false },
    { "name": "bureau_score", "path": "/bureau_report/score", "type": "int", "required": false },
    { "name": "bureau_defaults", "path": "/bureau_report/default_accounts", "type": "int", "required": false }
  ],
  "expressions": [
    { "name": "tenor", "expr": "coalesce(requested_tenor_months, default_tenor_months)" },
    { "name": "rate_bps", "expr": "coalesce(annual_interest_rate_bps, apr_bps)" },
    { "name": "min_age", "expr": "coalesce(min_age_years, 18)" },
    { "name": "min_income", "expr": "coalesce(min_monthly_income, 0.00)" },
    { "name": "max_foir", "expr": "coalesce(max_foir_policy, 0.5)" },
    { "name": "refer_foir", "expr": "round(max_foir * 0.8, 4)" },
    { "name": "obligations", "expr": "coalesce(existing_obligations, 0.00)" },
    { "name": "age", "expr": "coalesce(age_years(date_of_birth, today), age_input)" },
    { "name": "tenor_years", "expr": "years_from_months(tenor)" },
    { "name": "age_at_maturity", "expr": "age + tenor_years" },
    { "name": "estimated_emi", "expr": "emi(requested_amount, rate_bps, tenor)" },
    { "name": "foir", "expr": "round((obligations + estimated_emi) / monthly_income, 4)" }
  ],
  "findings": [
    { "id": "r_amount_required", "when": ["requested_amount == null"], "severity": "error", "code": "AMOUNT_REQUIRED", "regulation": "RBI-DL-2025", "message": "Requested amount is required to assess eligibility.", "path": "product.requestedAmount", "audience": "borrower" },
    { "id": "r_amount_below_min", "when": ["requested_amount != null", "min_amount != null", "requested_amount < min_amount"], "severity": "error", "code": "AMOUNT_BELOW_MIN", "regulation": "RBI-DL-2025", "message": "Requested amount is below the product minimum.", "path": "product.requestedAmount", "audience": "borrower" },
    { "id": "r_amount_above_max", "when": ["requested_amount != null", "max_amount != null", "requested_amount > max_amount"], "severity": "error", "code": "AMOUNT_ABOVE_MAX", "regulation": "RBI-DL-2025", "message": "Requested amount exceeds the product maximum.", "path": "product.requestedAmount", "audience": "borrower" },
    { "id": "r_tenor_required", "when": ["tenor == null or tenor <= 0"], "severity": "error", "code": "TENOR_REQUIRED", "regulation": "RBI-DL-2025", "message": "Requested tenor is required to assess eligibility.", "path": "product.requestedTenorMonths", "audience": "borrower" },
    { "id": "r_tenor_below_min", "when": ["tenor != null and tenor > 0", "min_tenor_months != null", "tenor < min_tenor_months"], "severity": "error", "code": "TENOR_BELOW_MIN", "regulation": "RBI-DL-2025", "message": "Requested tenor is below the product minimum.", "path": "product.requestedTenorMonths", "audience": "borrower" },
    { "id": "r_tenor_above_max", "when": ["tenor != null and tenor > 0", "max_tenor_months != null", "tenor > max_tenor_months"], "severity": "error", "code": "TENOR_ABOVE_MAX", "regulation": "RBI-DL-2025", "message": "Requested tenor exceeds the product maximum.", "path": "product.requestedTenorMonths", "audience": "borrower" },
    { "id": "r_age_required", "when": ["age == null"], "severity": "error", "code": "AGE_REQUIRED", "regulation": "RBI-DL-2025", "message": "Borrower age is required to assess eligibility.", "path": "borrower.dateOfBirth", "audience": "borrower" },
    { "id": "r_age_below_min", "when": ["age != null", "age < min_age"], "severity": "error", "code": "AGE_BELOW_MIN", "regulation": "RBI-DL-2025", "message": "Borrower age is below the product minimum.", "path": "borrower.dateOfBirth", "audience": "borrower" },
    { "id": "r_age_at_maturity", "when": ["age != null", "max_age_years != null", "age_at_maturity != null", "age_at_maturity > max_age_years"], "severity": "error", "code": "AGE_AT_MATURITY_ABOVE_MAX", "regulation": "RBI-DL-2025", "message": "Borrower age at maturity exceeds the product maximum.", "path": "borrower.dateOfBirth", "audience": "borrower" },
    { "id": "r_income_required", "when": ["monthly_income == null or monthly_income <= 0.00"], "severity": "error", "code": "INCOME_REQUIRED", "regulation": "RBI-DL-2025", "message": "Borrower monthly income is required to assess creditworthiness.", "path": "economicProfile.monthlyIncome", "audience": "borrower" },
    { "id": "r_income_below_min", "when": ["monthly_income != null and monthly_income > 0.00", "monthly_income < min_income"], "severity": "error", "code": "INCOME_BELOW_MIN", "regulation": "RBI-DL-2025", "message": "Borrower monthly income is below the product eligibility minimum.", "path": "economicProfile.monthlyIncome", "audience": "borrower" },
    { "id": "r_bureau_defaults", "when": ["bureau_present", "bureau_defaults != null", "bureau_defaults > 0"], "severity": "error", "code": "BUREAU_DEFAULT_ACCOUNTS", "regulation": "RBI-DL-2025", "message": "Borrower has active default accounts on credit bureau.", "path": "bureauReport.defaultAccounts", "audience": "tenant_ops" },
    { "id": "r_score_below_min", "when": ["bureau_present", "bureau_score != null", "bureau_score < 600"], "severity": "error", "code": "SCORE_BELOW_MIN", "regulation": "RBI-DL-2025", "message": "Borrower credit score is below the minimum limit of 600.", "path": "bureauReport.score", "audience": "tenant_ops" },
    { "id": "r_score_review_band", "when": ["bureau_present", "bureau_score != null", "bureau_score >= 600 and bureau_score < 700"], "severity": "warn", "code": "SCORE_REVIEW_BAND", "regulation": "RBI-DL-2025", "message": "Borrower credit score is within review band and requires manual underwriting.", "path": "bureauReport.score", "audience": "tenant_ops" },
    { "id": "r_thin_file", "when": ["bureau_present", "bureau_score == null"], "severity": "warn", "code": "THIN_FILE", "regulation": "RBI-DL-2025", "message": "Borrower credit report has no score (thin file); routing to manual underwriting.", "path": "bureauReport.score", "audience": "tenant_ops" },
    { "id": "r_no_bureau_history", "when": ["not bureau_present"], "severity": "warn", "code": "NO_BUREAU_HISTORY", "regulation": "RBI-DL-2025", "message": "Borrower has no credit bureau history; routing to manual underwriting.", "path": "bureauReport", "audience": "tenant_ops" },
    { "id": "r_foir_exceeded", "when": ["foir != null", "foir > max_foir"], "severity": "error", "code": "FOIR_EXCEEDED", "regulation": "RBI-DL-2025", "message": "Fixed obligation to income ratio exceeds the product ceiling.", "path": "economicProfile.monthlyIncome", "audience": "tenant_ops" },
    { "id": "r_foir_review_band", "when": ["foir != null", "foir <= max_foir", "foir > refer_foir"], "severity": "warn", "code": "FOIR_REVIEW_BAND", "regulation": "RBI-DL-2025", "message": "Fixed obligation to income ratio is within review band and requires manual underwriting.", "path": "economicProfile.monthlyIncome", "audience": "tenant_ops" },
    { "id": "r_affordability_uncomputed", "when": ["estimated_emi == null"], "severity": "warn", "code": "AFFORDABILITY_UNCOMPUTED", "regulation": "RBI-DL-2025", "message": "Affordability could not be computed without amount, tenor, and interest rate.", "path": "product.annualInterestRateBps", "audience": "tenant_ops" }
  ],
  "outcome": "severity_fold",
  "outputs": {
    "age": "age",
    "age_at_maturity": "age_at_maturity",
    "estimated_emi": "estimated_emi",
    "foir": "foir",
    "tenor_months": "tenor"
  }
}
