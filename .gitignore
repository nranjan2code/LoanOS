# Dependency directories
node_modules/
jspm_packages/

# Build outputs
dist/
build/
out/
coverage/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Rust (rules engine workspace)
rules/target/

# Android (machine-local SDK path, build outputs, generated wrapper jar)
apps/android-*/local.properties
apps/android-*/**/build/
apps/android-*/.gradle/
apps/android-*/*.iml
apps/android-*/.cxx/
apps/android-*/captures/

# Runtime data & DBs
.loanos-data/
*.db
*.sqlite

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDEs and editors
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Agent and temporary files. Skills are governed source (canonical copy in
# .agents/skills/, mirrored into .claude/skills as a symlink), so they are
# committed; local agent settings and launch config stay machine-specific.
.claude/*
!.claude/skills
.gemini/
tmp/
temp/

# Sensitive files / environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key

# Runtime PIDs
*.pid

# Local full-source backup snapshots (manual, machine-local — never versioned)
loanos-demo-source-*.tar.gz
