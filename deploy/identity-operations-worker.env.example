# Tenant-bound identity operations worker. Never commit real credentials.
LOANOS_API_URL=https://api.example.in
LOANOS_IDENTITY_WORKER_API_KEY=replace-with-secret-manager-injection
LOANOS_IDENTITY_WORKER_ID=identity-worker-tenant-001-a

# The repository ships a deterministic conformance simulator only. A vendor
# deployment must inject certified ports before selecting live.
LOANOS_IDENTITY_WORKER_EXECUTION_MODE=simulated
LOANOS_ALLOW_SIMULATED_IDENTITY_WORKER=true

LOANOS_IDENTITY_WORKER_MAX_JOBS=25
LOANOS_IDENTITY_WORKER_LEASE_MS=30000
LOANOS_IDENTITY_WORKER_JOB_TIMEOUT_MS=10000
LOANOS_IDENTITY_WORKER_REQUEST_TIMEOUT_MS=10000
LOANOS_IDENTITY_WORKER_INTERVAL_MS=15000
LOANOS_IDENTITY_WORKER_HEALTH_PORT=3041
